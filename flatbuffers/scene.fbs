include "asset.fbs";

namespace Arcadia.Serialization;

table Scene{
    Name:string;

    Cubemaps:[Cubemap];
    Materials:[Material];
    Meshes:[Mesh];
    Texture2ds:[Texture2d];
    
    Cameras:[Camera];
    Models:[Model];
    Skyboxes:[Skybox];
    CurrentSkyboxName:string;

}

root_type Scene;