namespace Arcadia.Serialization;

struct vec2{
    x:float;
    y:float;
}
struct vec3{
    x:float;
    y:float;
    z:float;
}

struct ivec2{
    x:int;
    y:int;
}
struct ivec3{
    x:int;
    y:int;
    z:int;
}

struct uvec2{
    x:uint;
    y:uint;
}
struct uvec3{
    x:uint;
    y:uint;
    z:uint;
}