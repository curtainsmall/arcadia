include"math.fbs";

namespace arcadia.serialization;

table window{
    title:string;
    size:uvec2;
    pos:uvec2;
    swap_interval:int;
    visible:bool;
    cursor_mode:int;
    sticky_keys:bool;
    sticky_mouse_buttons:bool;
    lock_key_mode:bool;
    raw_mouse_motion:bool;
}

root_type window;